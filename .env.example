# Database (SQLite file path, used by the Prisma driver adapter)
DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens. Generate a strong random value in production,
# e.g. `openssl rand -base64 48`
SESSION_SECRET="replace-with-a-long-random-secret"

# Public base URL of the app (used for links in emails/notifications, QR codes, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local file upload storage
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_SIZE_MB=5

# --- Optional integrations (not required to run the app) ---

# Email (for notifications / password reset emails)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Bodygraph Manager <no-reply@example.com>"

# SMS provider (for attendance/payment reminders)
# SMS_API_KEY=
# SMS_SENDER_ID=

# WhatsApp Business API
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_ID=

# Razorpay (online payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Stripe (online payments)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
